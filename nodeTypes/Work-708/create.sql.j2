{# == Node Type Name           : Work  == #}
{# == Node Type Description    : This node creates work table or view with advanced deployment strategy  == #}
{#---------------------------------------------------------------------------------------------#}

{#- Advanced deploy: node / columns / config / sources point at desiredState (shared macros, section 0).
    First deploy has no currentState; a deleted node has no desiredState.
    The create / redeploy stages are built by deploy_table_sql() / deploy_view_sql() in the shared macros. #}

{%- if desiredState %}

    {# Validate: the materialization type must be table or view #}
    {{ validate_materialization_type() }}

    {%- if get_materialization_type(node.materializationType) | trim == 'view' %}

        {# Create the view, or recreate it when its definition changed #}
        {{ deploy_view_sql('Work') }}

    {%- else %}

        {# Create the table, or redeploy it:
           column changes  -> Clone Table -> Delete / Rename / Alter / Add Column -> Replace Table using Clone -> Delete Table
           data type change -> Clone Table -> Recreate Table -> Reload Table from Clone -> Delete Table
           comment -> altered on the table #}
        {{ deploy_table_sql('Work') }}

    {%- endif %}

{%- elif currentState is defined and currentState %}

    {# Node deleted: drop the current object #}
    {{ object_drop_sql() }}

{%- endif %}
