{# == Node Type Name           : Work  == #}
{# == Node Type Description    : Loads the work table with custom SQL logic (truncateInsert or append)  == #}
{#---------------------------------------------------------------------------------------------#}

{# == Validate: the materialization type must be table or view == #}
{{ validate_materialization_type() }}

{# == Materialization type from the node, normalised (case and spaces): table / view == #}
{%- set materializationType = get_materialization_type(node.materializationType) %}

{# == To run data quality tests before data insertion == #}
{{ run_tests('Before') }}

{%- if materializationType == 'table' %}

    {# == Determine write mode: truncateInsert (default) or append, matched case-insensitively == #}
    {%- if config.writeMode is defined and config.writeMode.parameters is defined and config.writeMode.parameters | length > 0 %}
        {%- set writeModeRaw = config.writeMode.parameters[0] | string | trim %}
    {%- else %}
        {%- set writeModeRaw = 'truncateInsert' %}
    {%- endif %}
    {%- set writeMode = writeModeRaw | lower %}

    {# == An unrecognised write mode stops the load instead of silently overwriting the table == #}
    {%- if writeMode not in ('truncateinsert', 'append') %}
        {%- set reason = '@writeMode("' ~ writeModeRaw ~ '") is not a recognised write mode. Use "truncateInsert" or "append".' %}
        {{ test_stage('Invalid configuration: writeMode', false) }}
        -- {{ reason }}
        {{ fail_sql(true, reason) }}
    {%- endif %}

    {#== Pre-SQL ==#}
    {{ run_pre_post_sql('Pre') }}

    {# == truncateInsert replaces the table contents (INSERT OVERWRITE); append adds rows (INSERT INTO).
          INSERT OVERWRITE keeps the table itself: its primary key, clustering / partitioning, tags and history. == #}
    {%- set insertKeyword = 'INTO' if writeMode == 'append' else 'OVERWRITE' %}

    {# == Insert data from sources into the Work table == #}
    {{ stage('Load Table Using ' ~ ('Append' if writeMode == 'append' else 'Truncate Insert')) }}
    INSERT {{ insertKeyword }} {{ ref_no_link(node.location.name, node.name) }}
    (
        {%- for col in sources[0].columns %}
        `{{ col.name }}`
        {%- if not loop.last %},{% endif %}
        {%- endfor %}
    )
    {{ sources[0].cteString }}
    SELECT {{ sources[0].selectModifier | default('', true) }}
    {%- for col in sources[0].columns %}
        {{ get_source_transform(col) }} AS `{{ col.name }}`
        {%- if not loop.last %},{% endif %}
    {%- endfor %}
    {{ sources[0].join }}

    {#== Post-SQL ==#}
    {{ run_pre_post_sql('Post') }}

{%- else %}
    {{ stage('Load Skipped for View') }}
    -- The node {{ node.name }} is materialized as View. Therefore, a Load operation is not supported.
    SELECT 1 AS INFO_MESSAGE WHERE FALSE
{%- endif %}

{# == To run data quality tests after data insertion == #}
{{ run_tests('After') }}
