{# == Node Type Name           : Dimension  == #}
{# == Node Type Description    : This node creates dimension table or view  == #}
{#---------------------------------------------------------------------------------------------#}

{%- set target = ref_no_link(node.location.name, node.name) %}

{%- if node.materializationType == 'table' %}

    {%- set ns = namespace(hasDefault=false, partitionCols=[], clusterItems=[], clusterCols=[], pkItems=[], pkCols=[]) %}

    {# == Partition columns: node-level @partitionBy (comma separated column list) or column-level @partitionBy == #}
    {%- if config.partitionBy is defined and config.partitionBy.parameters is defined and config.partitionBy.parameters | length > 0 %}
        {%- for p in (config.partitionBy.parameters[0] | string).split(',') %}
            {%- if p | trim | length > 0 %}
                {%- set ns.partitionCols = ns.partitionCols + [p | trim] %}
            {%- endif %}
        {%- endfor %}
    {%- endif %}

    {%- for col in columns %}
        {%- if col.partitionBy is defined %}
            {%- set ns.partitionCols = ns.partitionCols + ['`' ~ col.name ~ '`'] %}
        {%- endif %}
        {%- if col.clusterKey is defined and col.clusterKey.parameters is defined %}
            {%- set ns.clusterItems = ns.clusterItems + [{'position': col.clusterKey.parameters[0] | int, 'name': col.name}] %}
        {%- endif %}
        {%- if col.primaryKey is defined and col.primaryKey.parameters is defined %}
            {%- set ns.pkItems = ns.pkItems + [{'position': col.primaryKey.parameters[0] | int, 'name': col.name}] %}
        {%- endif %}
    {%- endfor %}

    {%- for c in ns.clusterItems | sort(attribute='position') %}
        {%- set ns.clusterCols = ns.clusterCols + ['`' ~ c.name ~ '`'] %}
    {%- endfor %}
    {%- for c in ns.pkItems | sort(attribute='position') %}
        {%- set ns.pkCols = ns.pkCols + [c.name] %}
    {%- endfor %}

    {# CreateSQL for Table #}
    {{ stage('Create Dimension Table') }}
    CREATE OR REPLACE TABLE {{ target }}
    (
        {%- for col in columns %}
            `{{ col.name }}` {{ col.dataType }}
            {%- if col.isSurrogateKey is defined %} GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1)
            {%- elif col.defaultValue %} DEFAULT {{ col.defaultValue }} {%- set ns.hasDefault = true %}
            {%- endif %}
            {%- if col.nullable == false or col.name in ns.pkCols %} NOT NULL {%- endif %}
            {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}'{% endif %}
            {%- if not loop.last or ns.pkCols | length > 0 -%}, {%- endif %}
        {%- endfor %}
        {%- if ns.pkCols | length > 0 %}
            CONSTRAINT `pk_{{ node.name }}` PRIMARY KEY ({%- for c in ns.pkCols %}`{{ c }}`{%- if not loop.last %}, {% endif %}{%- endfor %})
        {%- endif %}
    )
    {%- if ns.partitionCols | length > 0 %}
    PARTITIONED BY ({{ ns.partitionCols | join(', ') }})
    {%- endif %}
    {%- if ns.clusterCols | length > 0 %}
    CLUSTER BY ({{ ns.clusterCols | join(', ') }})
    {%- endif %}
    {%- if node.description | trim | length > 0 %}
    COMMENT '{{ node.description | escape }}'
    {%- endif %}
    TBLPROPERTIES('delta.columnMapping.mode' = 'name'{%- if ns.hasDefault %}, 'delta.feature.allowColumnDefaults' = 'supported'{%- endif %})

{%- elif node.materializationType == 'view' %}

    {# CreateSQL for View #}
    {{ stage('Create Dimension View') }}
    CREATE OR REPLACE VIEW {{ target }}
    (
        {%- for col in columns %}
            `{{ col.name }}`
            {%- if col.description | trim | length > 0 %} COMMENT '{{ col.description | escape }}'{% endif %}
            {%- if not loop.last -%}, {%- endif %}
        {%- endfor %}
    )
    {%- if node.description | trim | length > 0 %} COMMENT '{{ node.description | escape }}'{% endif %}
    AS
    {{ sources[0].cteString }}
    SELECT {{ sources[0].selectModifier | default('', true) }}
    {%- for col in sources[0].columns %}
        {{ get_source_transform(col) }} AS `{{ col.name }}`
        {%- if not loop.last -%}, {%- endif %}
    {%- endfor %}
    {{ sources[0].join }}
{%- endif %}

{# == Unity Catalog tags (@tag on the node) - applied to tables and views == #}
{%- set tagNs = namespace(items=[]) %}
{%- for t in config.tag | default([]) %}
    {%- if t is mapping and t.parameters is defined and t.parameters | length > 1 %}
        {%- set tagNs.items = tagNs.items + ["'" ~ (t.parameters[0] | trim) ~ "' = '" ~ (t.parameters[1] | trim) ~ "'"] %}
    {%- endif %}
{%- endfor %}
{%- if tagNs.items | length > 0 %}
    {{ stage('Set Tags') }}
    ALTER {{ 'VIEW' if node.materializationType == 'view' else 'TABLE' }} {{ target }}
    SET TAGS ({{ tagNs.items | join(', ') }})
{%- endif %}
