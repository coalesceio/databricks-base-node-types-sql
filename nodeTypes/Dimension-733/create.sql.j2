{# == Node Type Name           : Dimension  == #}
{# == Node Type Description    : This node creates dimension table or view with advanced deployment strategy  == #}
{#---------------------------------------------------------------------------------------------#}

{#- Advanced deploy: node / columns / config / sources point at desiredState (shared macros, section 0).
    First deploy has no currentState; a deleted node has no desiredState.
    The create / redeploy stages are built by deploy_table_sql() / deploy_view_sql() in the shared macros. #}

{%- if desiredState %}

    {# Validate: the materialization type must be table or view #}
    {{ validate_materialization_type() }}

    {# Warn: the same tag key applied more than once (the last value is applied) #}
    {{ tag_check_duplicates() }}

    {%- if get_materialization_type(node.materializationType) | trim == 'view' %}

        {# Create the view, or recreate it when its definition changed; tags altered in place #}
        {{ deploy_view_sql('Dimension') }}

    {%- else %}

        {# Validate the Dimension annotations (hard fail: CREATE does not fail a test stage on row count) #}
        {{ validate_dimension_requirements(true) }}

        {# Validate: partition on the node or on columns, not combined with clustering, at most 4 cluster columns #}
        {{ validate_partition_cluster() }}

        {# Create the table, or redeploy it:
           column changes  -> Clone Table -> Delete / Rename / Alter / Add Column -> Replace Table using Clone -> Delete Table
           partitioning, data type or identity change -> Clone Table -> Recreate Table -> Reload Table from Clone -> Delete Table
           comment, clustering, primary key, tags -> altered on the table #}
        {{ deploy_table_sql('Dimension') }}

    {%- endif %}

{%- elif currentState is defined and currentState %}

    {# Node deleted: drop the current object #}
    {{ object_drop_sql() }}

{%- endif %}
